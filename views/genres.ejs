<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>All Genres</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include('navbar') %>
    <main class="genres-container">
        <a href="/genres/new" class="create-btn">Add a Genre</a>
      <h1 class="page-title"><%= title %></h1>
      <div class="all-genres">
        <ul class="genres-list">
            <%genres.map((genre)=> { %>
                <li class="genre-item"><%=genre.name%></li>
                <a href="/genres/<%=genre.name%>/<%=genre.id%>" class="btn">Show Games</a>
                <a href="/genres/edit/<%=genre.id%>">Edit This Genre</a>
                <a href="/genres/delete/<%=genre.id%>">Delete This Genre</a>
            <%})%>

        </ul>
      </div>
      <div class="links">
        <a href="/" class="btn btn-secondary">Back to Home</a>
        <a href="/developers" class="btn btn-primary">View Developers</a>
        <a href="/games" class="btn btn-primary">View Games</a>
      </div>
    </main>
  </body>
</html>
