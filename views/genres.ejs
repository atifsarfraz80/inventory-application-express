<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>All Genres</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include('navbar') %>
    <main class="page-container">
      <div class="header-row">
        <h1 class="page-title">Genres</h1>
        <a href="/genres/new" class="btn btn-primary">+ Add Genre</a>
      </div>

      <div class="card-grid">
        <% if (genres && genres.length > 0) { %>
          <% genres.forEach(genre => { %>
            <div class="item-card">
              <h2 class="card-title"><%= genre.name %></h2>
              <div class="card-actions">
                <a href="/genres/<%= encodeURIComponent(genre.name) %>/<%= genre.id %>" class="btn btn-sm btn-primary">View Games</a>
                <a href="/genres/edit/<%= genre.id %>" class="btn btn-sm btn-secondary">Edit</a>
                <a href="/genres/delete/<%= genre.id %>" class="btn btn-sm btn-danger" onclick="return confirm('Delete this genre?')">Delete</a>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <p class="empty-state">No genres added yet.</p>
        <% } %>
      </div>

      <div class="btn-group-bottom">
        <a href="/" class="btn btn-secondary">Back to Home</a>
        <a href="/developers" class="btn btn-secondary">Developers</a>
        <a href="/games" class="btn btn-secondary">Games</a>
      </div>
    </main>
  </body>
</html>