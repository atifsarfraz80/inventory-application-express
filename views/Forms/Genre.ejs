<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= isEditing ? 'Edit Genre' : 'Add Genre' %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include('../navbar') %>
    <main class="page-container">
      <div class="form-card">
        <h1 class="form-title"><%= isEditing ? 'Edit Genre' : 'Add New Genre' %></h1>

        <% if (errors && errors.length > 0) { %>
          <div class="error-box">
            <ul>
              <% errors.forEach(err => { %>
                <li><%= err.msg %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <form class="genre-form" action="<%= isEditing ? `/genres/edit/${id}` : '/genres/new' %>" method="POST">
          <div class="form-group">
            <label for="name" class="form-label">Genre Name</label>
            <input
              type="text"
              name="name"
              id="name"
              class="form-input"
              value="<%= formData?.name || '' %>"
              placeholder="e.g. Metroidvania"
              required
            />
          </div>
          <button type="submit" class="btn btn-primary btn-block">
            <%= isEditing ? 'Update Genre' : 'Add Genre' %>
          </button>
        </form>
      </div>
    </main>
  </body>
</html>