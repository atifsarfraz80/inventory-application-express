<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= isEditing ? 'Edit Game' : 'Add Game' %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include('../navbar') %>
    <main class="page-container">
      <div class="form-card">
        <h1 class="form-title"><%= isEditing ? 'Edit Game' : 'Add New Game' %></h1>

        <% if (errors && errors.length > 0) { %>
          <div class="error-box">
            <ul>
              <% errors.forEach(err => { %>
                <li><%= err.msg %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <form class="game-form" action="<%= isEditing ? `/games/edit/${id}` : '/games/new' %>" method="POST">
          <div class="form-group">
            <label for="title" class="form-label">Game Title</label>
            <input
              type="text"
              name="title"
              id="title"
              class="form-input"
              value="<%= formData?.title || '' %>"
              placeholder="e.g. Half-Life 2"
              required
            />
          </div>

          <div class="form-group">
            <label for="rating" class="form-label">Rating (0.0 - 10.0)</label>
            <input
              type="number"
              step="0.1"
              min="0"
              max="10"
              name="rating"
              id="rating"
              class="form-input"
              value="<%= formData?.rating || '' %>"
              placeholder="e.g. 9.5"
              required
            />
          </div>

          <div class="form-group">
            <label for="description" class="form-label">Description</label>
            <textarea
              name="description"
              id="description"
              class="form-textarea"
              rows="4"
              placeholder="Write game description..."
              required
            ><%= formData?.description || '' %></textarea>
          </div>

          <div class="form-group">
            <span class="form-label">Genres</span>
            <div class="checkbox-grid">
              <% genres.forEach(genre => { %>
                <label class="checkbox-label">
                  <input 
                    type="checkbox" 
                    name="genres" 
                    value="<%= genre.id %>"
                    <%= selectedGenres.includes(genre.id) ? 'checked' : '' %>
                  />
                  <span><%= genre.name %></span>
                </label>
              <% }) %>
            </div>
          </div>

          <div class="form-group">
            <span class="form-label">Developers</span>
            <div class="checkbox-grid">
              <% developers.forEach(dev => { %>
                <label class="checkbox-label">
                  <input 
                    type="checkbox" 
                    name="developers" 
                    value="<%= dev.id %>"
                    <%= selectedDevelopers.includes(dev.id) ? 'checked' : '' %>
                  />
                  <span><%= dev.name %></span>
                </label>
              <% }) %>
            </div>
          </div>

          <button type="submit" class="btn btn-primary btn-block">
            <%= isEditing ? 'Update Game' : 'Add Game' %>
          </button>
        </form>
      </div>
    </main>
  </body>
</html>