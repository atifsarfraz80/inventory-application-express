<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add a new Developer</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="page-container">
      <div class="form-card">
        <h1 class="form-title"><%= isEditing ? 'Edit Genre' : 'Add New Genre' %></h1>

        <% if (errors && errors.length > 0) { %>
          <div class="error-box">
            <ul>
              <% errors.forEach(err => { %>
                <li><%= err.msg %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <form class="developer-form" action="<%= isEditing ? `/developers/edit/${id}` : '/developers/new' %>" method="POST">
  <div class="form-group">
    <label for="name" class="form-label">Developer Name</label>
    <input
      type="text"
      name="name"
      id="name"
      class="form-input"
      value="<%= isEditing ? name : '' %>"
      placeholder="e.g. Rockstar Games"
      required
    />
  </div>
  <button type="submit" class="btn btn-primary btn-block">
    <%= isEditing ? 'Update Developer' : 'Add Developer' %>
  </button>
</form>

      </div>
    </main>
  </body>
</html>