<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= isEditing ? 'Edit Developer' : 'Add Developer' %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include('../navbar') %>
    <main class="page-container">
      <div class="form-card">
        <h1 class="form-title"><%= isEditing ? 'Edit Developer' : 'Add New Developer' %></h1>

        <% if (errors && errors.length > 0) { %>
          <div class="error-box">
            <ul>
              <% errors.forEach(err => { %>
                <li><%= err.msg %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <form class="developer-form" action="<%= isEditing ? `/developers/edit/${id}` : '/developers/new' %>" method="POST">
          <div class="form-group">
            <label for="name" class="form-label">Developer Name</label>
            <input
              type="text"
              name="name"
              id="name"
              class="form-input"
              value="<%= formData?.name || '' %>"
              placeholder="e.g. Valve"
              required
            />
          </div>
          <button type="submit" class="btn btn-primary btn-block">
            <%= isEditing ? 'Update Developer' : 'Add Developer' %>
          </button>
        </form>
      </div>
    </main>
  </body>
</html>