<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include('../navbar') %>
    <main class="page-container">
      <div class="header-row">
        <h1 class="page-title"><%= title %></h1>
      </div>

      <div class="card-grid">
        <% if (games && games.length > 0) { %>
          <% games.forEach(game => { %>
            <div class="item-card">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
                <h2 class="card-title"><%= game.title %></h2>
                <span class="rating-badge">★ <%= Number(game.rating).toFixed(1) %></span>
              </div>
              <p class="card-desc"><%= game.description %></p>
            </div>
          <% }) %>
        <% } else { %>
          <p class="empty-state">No games cataloged under this genre yet.</p>
        <% } %>
      </div>

      <div class="btn-group-bottom">
        <a href="/genres" class="btn btn-secondary">← Back to Genres</a>
        <a href="/games" class="btn btn-secondary">All Games</a>
      </div>
    </main>
  </body>
</html>