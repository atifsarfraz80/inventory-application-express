<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Games by genre</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include('../navbar') %>
    <main class="games-container">
      <h1 class="page-title"><%= title %></h1>
      <div class="all-games">
        <%if(games.length>0) {%>
        <ul class="games-list">
            <%games.map((game)=> { %>
                <li class="game-item">
                    <div class="game-title"><%=game.title%></div>
                    <div class="game-rating">Rating: <%=game.rating%></div>
                    <div class="game-description"><%=game.description%></div>
                </li>
            <%})%>
        </ul>
        <%} else {%>
            <p class="text">No games in this genre.</p>
        <%}%>
      </div>
      <div class="links">
        <a href="/" class="btn btn-secondary">Home</a>
        <a href="/developers" class="btn btn-primary">View Developers</a>
        <a href="/genres" class="btn btn-primary">Back to Genres</a>
        <a href="/games" class="btn btn-primary">View Games</a>
      </div>
    </main>
  </body>
</html>
