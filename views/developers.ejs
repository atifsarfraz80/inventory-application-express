<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>All Developers</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include('navbar') %>
    <main class="page-container">
      <div class="header-row">
        <h1 class="page-title">Developers</h1>
        <a href="/developers/new" class="btn btn-primary">+ Add Developer</a>
      </div>

      <div class="card-grid">
        <% if (developers && developers.length > 0) { %>
          <% developers.forEach(dev => { %>
            <div class="item-card">
              <h2 class="card-title"><%= dev.name %></h2>
              <div class="card-actions">
                <a href="/developers/<%= encodeURIComponent(dev.name) %>/<%= dev.id %>" class="btn btn-sm btn-primary">Show Catalog</a>
                <a href="/developers/edit/<%= dev.id %>" class="btn btn-sm btn-secondary">Edit</a>
                <a href="/developers/delete/<%= dev.id %>" class="btn btn-sm btn-danger" onclick="return confirm('Delete this developer?')">Delete</a>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <p class="empty-state">No developers registered yet.</p>
        <% } %>
      </div>

      <div class="btn-group-bottom">
        <a href="/" class="btn btn-secondary">Back to Home</a>
        <a href="/genres" class="btn btn-secondary">Genres</a>
        <a href="/games" class="btn btn-secondary">Games</a>
      </div>
    </main>
  </body>
</html>